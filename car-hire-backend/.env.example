# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-value

# Persistent car-image storage.
# In Railway, mount a persistent volume at this path.
UPLOAD_DIR=/data/uploads

# MySQL
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false

# Gmail confirmation emails
# Required: the Gmail/Google Workspace address that sends the emails.
EMAIL_USER=seventhcar@gmail.com

# Required: the 16-character Google app password, not the normal Gmail password.
# Spaces are accepted and removed automatically.
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional: where the business notification is sent.
# Defaults to EMAIL_USER. Multiple addresses may be comma-separated.
EMAIL_BUSINESS_RECIPIENT=seventhcar@gmail.com

# Optional display/reply settings.
EMAIL_FROM_NAME=Seventh Seychelles Car Rental
EMAIL_REPLY_TO=seventhcar@gmail.com
COMPANY_PHONE=+248 2502815
